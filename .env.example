# Mem0 环境变量配置
# 使用阿里云百炼（通义千问）- 无需 OpenAI

# 百炼 API 密钥（必填）
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 百炼基础 URL（可选，默认如下）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 嵌入模型（可选，默认：text-embedding-v3）
# 用于语义搜索（核心功能）
# EMBEDDING_MODEL=text-embedding-v3

# LLM 模型（可选，默认：qwen-plus）
# 用于从对话中提取记忆
# LLM_MODEL=qwen-plus

# 用户 ID（可选，默认：default）
MEM0_USER_ID=default

# JSON 输出模式（可选）
# JSON_OUTPUT=1

# 历史数据库路径（可选）
# MEM0_HISTORY_DB=~/.mem0/history.db
